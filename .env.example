# Copy to .env and fill in your local values.
# .env should be git-ignored.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True
# Comma-separated list of hostnames Django will accept.
# In prod set this to your real domain, e.g. sho.rt,www.sho.rt
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres
# For docker-compose, POSTGRES_HOST is overridden to "db" (the service name).
# On Render + Neon, paste values from Neon's connection string.
# POSTGRES_SSLMODE: 'prefer' for local (no SSL), 'require' for managed (Neon/RDS).
POSTGRES_DB_NAME=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# Redis
# Local: leave REDIS_URL unset and use the individual host/port/db vars below.
# Prod (Railway/Render): set REDIS_URL from the managed Redis plugin instead.
# REDIS_URL=redis://:password@host:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=86400

# Rate limiting (fixed window per IP, per bucket).
# WINDOW_SECONDS = bucket size in seconds (60 = per minute).
# SHORTEN  = max POST /api/shorten per window per IP.
# REDIRECT = max GET /<short_code> per window per IP.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_SHORTEN_PER_MINUTE=10
RATE_LIMIT_REDIRECT_PER_MINUTE=100

# Public base URL used when returning short links.
# In prod this would be your domain (e.g. https://sho.rt).
PUBLIC_BASE_URL=http://127.0.0.1:8000
