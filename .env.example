# Copy to .env and fill in your local values.
# .env should be git-ignored.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True

# Postgres
POSTGRES_DB_NAME=urlshortener
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_TTL_SECONDS=86400

# Public base URL used when returning short links.
# In prod this would be your domain (e.g. https://sho.rt).
PUBLIC_BASE_URL=http://127.0.0.1:8000
